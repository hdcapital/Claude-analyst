# Claude API key (required)
ANTHROPIC_API_KEY=

# Path to the market-ingestion lake. Any of:
#   - a synced lake root (directory containing documents/ and manifests/),
#     e.g. ~/market-data after `aws s3 sync s3://$AWS_BUCKET_NAME/market-data/ ~/market-data/`
#   - the market-ingestion repo checkout (its _lake/ dry-run output is used)
#   - s3://<bucket>/market-data/ to read the lake straight from S3 (needs AWS creds + boto3)
# If unset, the adapter searches for a checkout/lake in the usual places.
MARKET_INGESTER_PATH=

# Where the analyst's own SQLite DB, company files and briefs live (required)
ANALYST_DATA_DIR=./data

# Hard caps on Anthropic API spend, USD (required)
ANALYST_BUDGET_USD_TOTAL=10
ANALYST_BUDGET_USD_DAILY=2

# Model overrides (optional; defaults resolved from the live models endpoint at first run)
TRIAGE_MODEL=
DEEP_MODEL=

# Optional
ANALYST_TIMEZONE=Australia/Sydney

# Only needed for MARKET_INGESTER_PATH=s3://...
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
